# LLM Provider Configuration
# Set the active provider: "ollama" (local) or "nvidia" (cloud API)
# LLM_PROVIDER=ollama

# Option 1: Ollama (local, no API key needed)
# Install: https://ollama.com
# Model: ollama pull gemma3:4b
# Run: ollama serve

# Option 2: Nvidia NIM (cloud API)
# Sign up at https://build.nvidia.com/
# NVIDIA_NIM_API_KEY=nvapi-...
# NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1/chat/completions
# NVIDIA_NIM_MODEL=meta/llama-3.1-8b-instruct
